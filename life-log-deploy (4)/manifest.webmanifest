{
  "name": "生活记录台",
  "short_name": "生活记录",
  "description": "记录每天的吃喝运动，附手绘贴纸小冰箱",
  "id": "./",
  "start_url": "./index.html?v=3",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
